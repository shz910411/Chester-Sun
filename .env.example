# ====== 迈思美后端环境变量模板 ======
# 真实值在服务器上写入 .env（已 gitignore，绝不进仓库）

# 运行端口（容器内，外部经 docker-compose 映射到宿主 8090）
PORT=3000

# 数据库（容器内主机名 = maisimei-db，外部碰不到）
DB_HOST=maisimei-db
DB_PORT=5432
DB_USER=maisimei
DB_PASSWORD=__在服务器上改成强密码__
DB_NAME=maisimei
DB_SYNC=true                 # 首次部署自动建表；表结构稳定后改 false

# JWT 会话密钥（随机长串）
JWT_SECRET=__在服务器上改成随机长串__
JWT_EXPIRES=30d

# 首次启动自动创建的后台管理员（建好后可在后台改密；留空则不自动建）
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=__在服务器上设一个后台登录密码__

# 微信小程序（AppSecret 只放这里，绝不进 Git/聊天）
WX_APPID=wx8efa54570a30e62f
WX_APPSECRET=__在服务器上填__

# AI 餐食解析（阿里云百炼 / 备路），key 只放这里
DASHSCOPE_API_KEY=__在服务器上填__
FOOD_VISION_PRIMARY=qwen-vl-plus

# 对象存储 OSS（餐照/秤照私有桶）——M1 接入时填
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
